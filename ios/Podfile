# Committed on purpose. Without a Podfile the Flutter tool generates one from
# its template at build time, and that template leaves `platform :ios` commented
# out -- so the pod deployment target came from whatever CocoaPods defaulted to
# on that machine. On a CI runner that is not a value we want decided for us.
#
# 15.0, not the 13.0 the Xcode project shipped with. `firebase_core` and
# `firebase_messaging` both declare `s.ios.deployment_target = '15.0'`, and
# CocoaPods refuses the whole resolution rather than warning:
#
#   [!] CocoaPods could not find compatible versions for pod "firebase_core"
#       ... they required a higher minimum deployment target
#
# Every other plugin in this app asks for 13.0 or lower, so Firebase alone sets
# the floor. Re-derive it after any plugin bump with:
#   grep -r "ios.deployment_target" ~/.pub-cache/hosted/pub.dev/*/ios/*.podspec
#
# The number must stay in lockstep with:
#   - IPHONEOS_DEPLOYMENT_TARGET in ios/Runner.xcodeproj/project.pbxproj (x3)
#   - MinimumOSVersion in ios/Flutter/AppFrameworkInfo.plist
# If those disagree, App Store Connect accepts the upload and then rejects it
# during processing, long after the build looked green.
#
# Cost of the floor: iOS 15 needs an iPhone 6s or newer (2015+). It drops the
# iPhone 6/6 Plus and 5s.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Pods inherit their own (often lower) deployment target from their
    # podspec; force every one of them up to the app's. Firebase 11 and
    # geolocator both ship pods that otherwise emit "target ... is lower than
    # the minimum supported" warnings that become errors under newer Xcode.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
