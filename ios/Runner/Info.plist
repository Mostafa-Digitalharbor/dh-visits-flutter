<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Visits</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Visits</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- ============================================================ -->
		<!-- Location permission usage string. WhenInUse only — the app    -->
		<!-- collects location while the user is actively using it and     -->
		<!-- intentionally stops when backgrounded. Localized strings in   -->
		<!-- en.lproj/InfoPlist.strings and ar.lproj/InfoPlist.strings.    -->
		<!-- ============================================================ -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>We use your location to record customer visit check-in/out and to share your live position with your manager while you are using the app.</string>
		<!-- Camera: proof-of-visit photos attached to a visit. -->
		<key>NSCameraUsageDescription</key>
		<string>We use the camera so you can attach proof-of-visit photos to a customer visit.</string>
		<!-- Required even though the app never opens the photo library: it only
		     calls ImagePicker with ImageSource.camera. The image_picker_ios and
		     file_picker plugins link PHPhotoLibrary symbols regardless, and
		     Apple's static check rejects the upload on the reference alone —
		     "90683: Missing purpose string in Info.plist … While your app might
		     not use these APIs, a purpose string is still required."
		     It arrives after a clean archive, export and upload, so it costs a
		     full macOS build to learn. Keep the wording honest about what the
		     access is for; a vague string draws a 5.1.1 review rejection. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>We ask for photo library access so you can attach an existing photo or file to a customer visit as proof of the visit.</string>
		<!-- App Transport Security: enforce HTTPS only (matches Android usesCleartextTraffic=false). -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
		</dict>
		<!-- Encryption export compliance: app uses only standard HTTPS / secure storage. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Push notifications: allow the app to be woken by a remote push so
		     FCM can deliver visit-workflow events in the background. Also enable
		     "Push Notifications" + "Background Modes → Remote notifications" in
		     the Xcode target Signing & Capabilities, and upload an APNs Auth Key
		     (.p8) to Firebase → Cloud Messaging. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>fetch</string>
		</array>
	</dict>
</plist>
