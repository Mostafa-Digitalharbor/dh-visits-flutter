<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Visits</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Visits</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- ============================================================ -->
		<!-- Location. Visit check-in/out and live sharing read location   -->
		<!-- while the app is in use. Between "Start Work Day" and "End     -->
		<!-- Work Day" the work-day route is also recorded in the          -->
		<!-- background and with the screen locked (WorkdayLocation.swift, -->
		<!-- UIBackgroundModes "location" below). "While Using" is enough  -->
		<!-- for that because capture always starts in the foreground;     -->
		<!-- "Always" is asked for afterwards, explained first in the app, -->
		<!-- and only adds relaunch after iOS terminated the app.          -->
		<!-- geolocator_apple still requests When In Use first: it checks  -->
		<!-- for NSLocationWhenInUseUsageDescription before Always.        -->
		<!-- Localized in en.lproj / ar.lproj InfoPlist.strings.           -->
		<!-- ============================================================ -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Visits uses your location to record customer visit check-in and check-out, to share your position with your manager while you use the app, and — while your work day is active — to record your work-day route, including in the background and with the screen locked. Route recording stops when you end your work day.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>While your work day is active, Visits records your work-day route in the background. Allowing location access "Always" lets recording resume if iOS closes the app during your work day. No route is recorded outside an active work day.</string>
		<key>NSLocationTemporaryUsageDescriptionDictionary</key>
		<dict>
			<key>WorkdayRoute</key>
			<string>Precise location is needed to record your work-day route and visits on the correct streets.</string>
		</dict>
		<!-- Camera: proof-of-visit photos attached to a visit. -->
		<key>NSCameraUsageDescription</key>
		<string>We use the camera so you can attach proof-of-visit photos to a customer visit.</string>
		<!-- Required even though the app never opens the photo library: it only
		     calls ImagePicker with ImageSource.camera. The image_picker_ios and
		     file_picker plugins link PHPhotoLibrary symbols regardless, and
		     Apple's static check rejects the upload on the reference alone —
		     "90683: Missing purpose string in Info.plist … While your app might
		     not use these APIs, a purpose string is still required."
		     It arrives after a clean archive, export and upload, so it costs a
		     full macOS build to learn. Keep the wording honest about what the
		     access is for; a vague string draws a 5.1.1 review rejection. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>We ask for photo library access so you can attach an existing photo or file to a customer visit as proof of the visit.</string>
		<!-- App Transport Security: enforce HTTPS only (matches Android usesCleartextTraffic=false). -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
		</dict>
		<!-- Encryption export compliance: app uses only standard HTTPS / secure storage. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Push notifications: allow the app to be woken by a remote push so
		     FCM can deliver visit-workflow events in the background. Also enable
		     "Push Notifications" + "Background Modes → Remote notifications" in
		     the Xcode target Signing & Capabilities, and upload an APNs Auth Key
		     (.p8) to Firebase → Cloud Messaging.
		     "location": work-day route capture continues in the background and
		     with the screen locked, only between Start and End Work Day. App
		     Review needs that explained in the review notes
		     (store/appstore/listing-en.md). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>remote-notification</string>
			<string>fetch</string>
		</array>
	</dict>
</plist>
