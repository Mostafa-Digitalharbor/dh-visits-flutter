<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Visits</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Visits</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- ============================================================ -->
		<!-- Location — customer visits only. A one-off fix is read when a  -->
		<!-- visit is started or ended, and while a visit is in progress   -->
		<!-- (between a server-confirmed Start Visit and End Visit) its    -->
		<!-- GPS trail is also recorded in the background and with the     -->
		<!-- screen locked (VisitLocation.swift, UIBackgroundModes          -->
		<!-- "location" below). Nothing is recorded outside an active      -->
		<!-- visit. "While Using" is enough because capture always starts   -->
		<!-- in the foreground; the app never asks for "Always" itself (the -->
		<!-- Always string is still required: geolocator_apple references  -->
		<!-- requestAlwaysAuthorization, and Apple's static check wants a   -->
		<!-- purpose string for it). If the user grants Always in Settings, -->
		<!-- iOS may relaunch the app to continue an active visit.         -->
		<!-- geolocator_apple requests When In Use: it checks for           -->
		<!-- NSLocationWhenInUseUsageDescription before Always.            -->
		<!-- Localized in en.lproj / ar.lproj InfoPlist.strings.           -->
		<!-- ============================================================ -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Visits uses your location when you start and end a customer visit, and records the route of a visit while it is in progress — including in the background and with the screen locked. Recording stops when you end the visit. No location is collected outside an active visit.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Visits records your route only while a customer visit is in progress. Allowing location access "Always" lets recording resume if iOS closes the app during an active visit. No location is collected outside an active visit.</string>
		<key>NSLocationTemporaryUsageDescriptionDictionary</key>
		<dict>
			<key>VisitRoute</key>
			<string>Precise location is needed to record the route of your active visit on the correct streets.</string>
		</dict>
		<!-- Camera: proof-of-visit photos attached to a visit. -->
		<key>NSCameraUsageDescription</key>
		<string>We use the camera so you can attach proof-of-visit photos to a customer visit.</string>
		<!-- Required even though the app never opens the photo library: it only
		     calls ImagePicker with ImageSource.camera. The image_picker_ios and
		     file_picker plugins link PHPhotoLibrary symbols regardless, and
		     Apple's static check rejects the upload on the reference alone —
		     "90683: Missing purpose string in Info.plist … While your app might
		     not use these APIs, a purpose string is still required."
		     It arrives after a clean archive, export and upload, so it costs a
		     full macOS build to learn. Keep the wording honest about what the
		     access is for; a vague string draws a 5.1.1 review rejection. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>We ask for photo library access so you can attach an existing photo or file to a customer visit as proof of the visit.</string>
		<!-- App Transport Security: enforce HTTPS only (matches Android usesCleartextTraffic=false). -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
		</dict>
		<!-- Encryption export compliance: app uses only standard HTTPS / secure storage. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Background modes.
		     "remote-notification": lets FCM deliver visit-workflow events in the
		     background. Also enable "Push Notifications" + "Background Modes →
		     Remote notifications" in the Xcode target Signing & Capabilities, and
		     upload an APNs Auth Key (.p8) to Firebase → Cloud Messaging.
		     "location": the GPS trail of a customer visit keeps recording in the
		     background and with the screen locked, only while that visit is in
		     progress. App Review needs that explained in the review notes
		     (store/appstore/). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>remote-notification</string>
		</array>
	</dict>
</plist>
