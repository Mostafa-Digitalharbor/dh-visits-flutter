# Copy to `.env.dev`, `.env.staging`, or `.env.production` and pass via
# `--dart-define-from-file=.env.production` when running/building.
#
# These values are baked into the binary at build time. Never commit real
# production credentials here -- only the example placeholders.

# ---- Backend (Odoo) ----------------------------------------------------------
API_BASE_URL=https://odoo.example.com
ODOO_DATABASE=your_db_name
APP_FLAVOR=production

# ---- Sentry crash reporting --------------------------------------------------
# Leave SENTRY_DSN empty to disable Sentry entirely (recommended for local dev
# so you don't burn your free quota on hot-reload exceptions).
#
# Get the DSN from: https://sentry.io  ->  Project Settings -> Client Keys (DSN).
# Format looks like:
#   https://<PUBLIC_KEY>@o<ORG_ID>.ingest.sentry.io/<PROJECT_ID>
SENTRY_DSN=

# Percentage of transactions to capture for performance monitoring (0-100).
# 10 is fine for production; raise to 100 in staging to validate instrumentation.
SENTRY_TRACES_PERCENT=10
